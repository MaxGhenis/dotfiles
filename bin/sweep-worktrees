#!/usr/bin/env bash
# sweep-worktrees — classify and remove stale git worktrees, including agent roots.
#
# Usage:
#   sweep-worktrees [REPO_OR_ROOT ...]
#   sweep-worktrees --dry-run [REPO_OR_ROOT ...]
#   sweep-worktrees --discover [BASE_DIR ...]
#   sweep-worktrees --remove-closed [REPO_OR_ROOT ...]
#
# Behavior:
#   - In a git repo with no args: sweep that repo's linked worktrees.
#   - Outside a git repo with no args: sweep ~/.codex-worktrees and ~/.claude-worktrees.
#   - If an arg is a git repo: sweep linked worktrees registered to that repo.
#   - If an arg is a directory root: inspect its child worktree directories.
#
# PR-aware classification:
#   - Detects PRs from directory names like pr-123 / review-123 when possible.
#   - Falls back to GitHub lookups by branch name, then HEAD SHA for detached worktrees.
#   - Auto-removes only clean merged worktrees by default.
#   - Closed-but-unmerged PR worktrees are reported, not removed, unless --remove-closed is set.

set -u

DRY_RUN=0
FORCE_DIRTY=0
REMOVE_CLOSED=0
DISCOVER=0
DISCOVER_MAXDEPTH=5
RECENT_HOURS=24
GH_READY_CACHE=""
ARGS=()

HOME_DIR=${HOME:-/Users/maxghenis}
TMPDIR_BASE=${TMPDIR:-/tmp}
SEEN_FETCH_FILE="$TMPDIR_BASE/sweep-worktrees.fetch.$$"
SEEN_PRUNE_FILE="$TMPDIR_BASE/sweep-worktrees.prune.$$"
PROCESS_CWDS_FILE="$TMPDIR_BASE/sweep-worktrees.proc.$$"
TMUX_PANES_FILE="$TMPDIR_BASE/sweep-worktrees.tmux.$$"
trap 'rm -f "$SEEN_FETCH_FILE" "$SEEN_PRUNE_FILE" "$PROCESS_CWDS_FILE" "$TMUX_PANES_FILE"' EXIT INT TERM
touch "$SEEN_FETCH_FILE" "$SEEN_PRUNE_FILE"
touch "$PROCESS_CWDS_FILE" "$TMUX_PANES_FILE"
NOW_EPOCH=$(date +%s)

# Files that frequently drift without semantic meaning in fresh worktrees. If
# the only dirty files match this list, treat the worktree as effectively clean.
BENIGN_DIRTY_PATTERNS='^(uv\.lock|Cargo\.lock|bun\.lock|bun\.lockb|package-lock\.json|yarn\.lock|pnpm-lock\.yaml|poetry\.lock|Pipfile\.lock|\.venv/?|venv/?|\.pytest_cache/?|\.ruff_cache/?|\.mypy_cache/?|\.tox/?)$|(^|/)(__pycache__|\.pytest_cache|\.ruff_cache|\.mypy_cache)/'

usage() {
  cat <<'EOF'
Usage:
  sweep-worktrees [REPO_OR_ROOT ...]
  sweep-worktrees --dry-run [REPO_OR_ROOT ...]
  sweep-worktrees --discover [BASE_DIR ...]

Options:
  --dry-run        Classify only; do not remove anything.
  --force-dirty    Allow removal of merged/closed worktrees with non-benign dirt.
  --remove-closed  Also remove clean worktrees for closed-but-unmerged PRs.
  --discover       Find common agent worktree roots below the given base dirs.
  --maxdepth N     Max depth for --discover. Default: 5.
  --recent-hours N Keep recently touched worktrees. Default: 24.
  -h, --help       Show this help.

Examples:
  sweep-worktrees --dry-run
  sweep-worktrees ~/PolicyEngine/policyengine-us-data
  sweep-worktrees ~/.codex-worktrees ~/.claude-worktrees
  sweep-worktrees --discover ~/PolicyEngine
EOF
}

have_cmd() {
  command -v "$1" >/dev/null 2>&1
}

gh_ready() {
  if [ -n "$GH_READY_CACHE" ]; then
    [ "$GH_READY_CACHE" = "1" ]
    return
  fi

  if have_cmd gh && gh auth status >/dev/null 2>&1; then
    GH_READY_CACHE=1
  else
    GH_READY_CACHE=0
  fi

  [ "$GH_READY_CACHE" = "1" ]
}

abspath_from() {
  local path=$1
  local base=$2
  case "$path" in
    /*) printf '%s\n' "$path" ;;
    *) (cd "$base" 2>/dev/null && cd "$path" 2>/dev/null && pwd -P) ;;
  esac
}

safe_label() {
  sed "s|^$HOME_DIR|~|"
}

is_git_repo() {
  git -C "$1" rev-parse --is-inside-work-tree >/dev/null 2>&1
}

is_linked_worktree_dir() {
  [ -d "$1" ] && [ -f "$1/.git" ] && is_git_repo "$1"
}

mark_once() {
  local file=$1
  local key=$2
  if grep -Fqx "$key" "$file" 2>/dev/null; then
    return 1
  fi
  printf '%s\n' "$key" >> "$file"
  return 0
}

github_repo_from_origin() {
  local url=$1
  url=${url%.git}
  case "$url" in
    https://github.com/*)
      printf '%s\n' "${url#https://github.com/}"
      ;;
    http://github.com/*)
      printf '%s\n' "${url#http://github.com/}"
      ;;
    git@github.com:*)
      printf '%s\n' "${url#git@github.com:}"
      ;;
    ssh://git@github.com/*)
      printf '%s\n' "${url#ssh://git@github.com/}"
      ;;
    *)
      return 1
      ;;
  esac
}

discover_roots() {
  local base
  for base in "$@"; do
    [ -d "$base" ] || continue
    find "$base" -maxdepth "$DISCOVER_MAXDEPTH" \
      \( -path "$HOME_DIR/Library" -o -path "$HOME_DIR/.Trash" -o -path "$HOME_DIR/.cache" -o -path '*/node_modules' -o -path '*/.git' \) -prune \
      -o -type d \( -name '.codex-worktrees' -o -name '.claude-worktrees' -o -name 'pr-worktrees' -o -name 'pr_worktrees' -o -name '_pr_worktrees' -o -name '_codex_prs' -o -path '*/.claude/worktrees' \) -print
  done | sort -u
}

stat_mtime() {
  local path=$1
  [ -e "$path" ] || return 1
  if stat -f '%m' "$path" >/dev/null 2>&1; then
    stat -f '%m' "$path"
  else
    stat -c '%Y' "$path"
  fi
}

format_age() {
  local age=$1
  if [ "$age" -lt 3600 ]; then
    printf '%sm' "$(( (age + 59) / 60 ))"
  elif [ "$age" -lt 86400 ]; then
    printf '%sh' "$(( (age + 3599) / 3600 ))"
  else
    printf '%sd' "$(( (age + 86399) / 86400 ))"
  fi
}

populate_process_cwds() {
  : > "$PROCESS_CWDS_FILE"
  have_cmd lsof || return 0
  lsof -nP -u "$USER" -Fpcn -d cwd 2>/dev/null | awk '
    BEGIN { pid=""; cmd="" }
    /^p/ { pid=substr($0, 2); cmd="" }
    /^c/ { cmd=substr($0, 2) }
    /^n/ {
      path=substr($0, 2)
      if (pid != "" && path != "") {
        print pid "\t" cmd "\t" path
      }
    }
  ' > "$PROCESS_CWDS_FILE" || true
}

populate_tmux_panes() {
  : > "$TMUX_PANES_FILE"
  have_cmd tmux || return 0
  tmux list-panes -a -F '#{session_name}:#{window_index}.#{pane_index}	#{pane_pid}	#{pane_current_path}' \
    > "$TMUX_PANES_FILE" 2>/dev/null || true
}

process_usage_summary() {
  local wt=$1
  awk -F'\t' -v wt="$wt" '
    function within(path, root) {
      return path == root || index(path, root "/") == 1
    }
    within($3, wt) {
      count++
      if (shown < 3) {
        shown++
        out = out (out ? "," : "") $1 ":" $2
      }
    }
    END {
      if (count > 0) {
        if (count > shown) {
          out = out ",..."
        }
        print out
      }
    }
  ' "$PROCESS_CWDS_FILE"
}

tmux_usage_summary() {
  local wt=$1
  awk -F'\t' -v wt="$wt" '
    function within(path, root) {
      return path == root || index(path, root "/") == 1
    }
    within($3, wt) {
      count++
      if (shown < 3) {
        shown++
        out = out (out ? "," : "") $1
      }
    }
    END {
      if (count > 0) {
        if (count > shown) {
          out = out ",..."
        }
        print out
      }
    }
  ' "$TMUX_PANES_FILE"
}

recent_activity_age() {
  local wt=$1
  local git_index=$2
  local git_head=$3
  local latest=0
  local candidate path

  [ "$RECENT_HOURS" -gt 0 ] || return 1

  # Avoid the worktree admin directory mtime itself: ordinary git inspection can
  # bump it and make every worktree look artificially recent.
  for path in "$wt" "$wt/.git" "$git_index" "$git_head"; do
    candidate=$(stat_mtime "$path" 2>/dev/null || true)
    if [ -n "$candidate" ] && [ "$candidate" -gt "$latest" ]; then
      latest=$candidate
    fi
  done

  [ "$latest" -gt 0 ] || return 1

  candidate=$((NOW_EPOCH - latest))
  [ "$candidate" -lt 0 ] && candidate=0
  if [ "$candidate" -lt $((RECENT_HOURS * 3600)) ]; then
    format_age "$candidate"
    return 0
  fi

  return 1
}

ahead_of_upstream_count() {
  local wt=$1
  local upstream

  upstream=$(git -C "$wt" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
  [ -n "$upstream" ] || { echo 0; return 0; }

  git -C "$wt" cherry "$upstream" HEAD 2>/dev/null \
    | awk '$1 == "+" { count++ } END { print count + 0 }' || echo 0
}

maybe_fetch_repo() {
  local wt=$1
  local common_dir=$2
  local default_branch=$3
  local key="${common_dir}|${default_branch}"
  if mark_once "$SEEN_FETCH_FILE" "$key"; then
    git -C "$wt" fetch --quiet --prune origin "$default_branch" 2>/dev/null || true
  fi
}

maybe_prune_repo() {
  local common_dir=$1
  if mark_once "$SEEN_PRUNE_FILE" "$common_dir"; then
    git --git-dir="$common_dir" worktree prune >/dev/null 2>&1 || true
  fi
}

extract_pr_number_from_name() {
  local name=$1
  if [[ "$name" =~ (^|[^0-9])pr[-_]?([0-9]+)([^0-9]|$) ]]; then
    printf '%s\n' "${BASH_REMATCH[2]}"
    return 0
  fi
  if [[ "$name" =~ (^|[^0-9])review[-_]?([0-9]+)([^0-9]|$) ]]; then
    printf '%s\n' "${BASH_REMATCH[2]}"
    return 0
  fi
  return 1
}

pr_lookup_by_number() {
  local repo_slug=$1
  local pr_number=$2
  gh pr view "$pr_number" -R "$repo_slug" \
    --json number,state,mergedAt,closedAt,url,headRefName \
    --jq '[.number, .state, (.mergedAt // ""), (.closedAt // ""), .url, (.headRefName // "")] | @tsv' \
    2>/dev/null
}

pr_lookup_by_branch() {
  local repo_slug=$1
  local branch=$2
  gh pr list -R "$repo_slug" --head "$branch" --state all --limit 20 \
    --json number,state,mergedAt,closedAt,url,headRefName,updatedAt \
    --jq 'sort_by(.updatedAt) | reverse | .[0] | if . then [.number, .state, (.mergedAt // ""), (.closedAt // ""), .url, (.headRefName // "")] | @tsv else empty end' \
    2>/dev/null
}

pr_lookup_by_sha() {
  local repo_slug=$1
  local sha=$2
  gh pr list -R "$repo_slug" --search "$sha" --state all --limit 20 \
    --json number,state,mergedAt,closedAt,url,headRefName,updatedAt \
    --jq 'sort_by(.updatedAt) | reverse | .[0] | if . then [.number, .state, (.mergedAt // ""), (.closedAt // ""), .url, (.headRefName // "")] | @tsv else empty end' \
    2>/dev/null
}

lookup_pr_info() {
  local repo_slug=$1
  local wt_name=$2
  local branch=$3
  local head_sha=$4
  local row=""
  local pr_number=""

  if [ -z "$repo_slug" ] || ! gh_ready; then
    return 1
  fi

  pr_number=$(extract_pr_number_from_name "$wt_name" 2>/dev/null || true)
  if [ -n "$pr_number" ]; then
    row=$(pr_lookup_by_number "$repo_slug" "$pr_number" || true)
    if [ -n "$row" ]; then
      printf '%s\t%s\n' "name" "$row"
      return 0
    fi
  fi

  if [ -n "$branch" ]; then
    row=$(pr_lookup_by_branch "$repo_slug" "$branch" || true)
    if [ -n "$row" ]; then
      printf '%s\t%s\n' "branch" "$row"
      return 0
    fi
  fi

  if [ -z "$branch" ] && [ -n "$head_sha" ]; then
    row=$(pr_lookup_by_sha "$repo_slug" "$head_sha" || true)
    if [ -n "$row" ]; then
      printf '%s\t%s\n' "sha" "$row"
      return 0
    fi
  fi

  return 1
}

describe_state() {
  local merged_state=$1
  local pr_state=$2
  local pr_number=$3
  local pr_source=$4
  local upstream_gone=$5

  local parts=""

  if [ "$merged_state" = "merged" ]; then
    parts="git-merged"
  elif [ "$merged_state" = "detached" ]; then
    parts="detached"
  else
    parts="git-unmerged"
  fi

  if [ -n "$pr_state" ]; then
    parts="$parts pr=$pr_state"
    [ -n "$pr_number" ] && parts="$parts#$pr_number"
    [ -n "$pr_source" ] && parts="$parts via-$pr_source"
  fi

  if [ "$upstream_gone" = "yes" ]; then
    parts="$parts upstream-gone"
  fi

  printf '%s\n' "$parts"
}

inspect_worktree() {
  local wt=$1
  local hinted_branchref=${2:-}

  [ -d "$wt" ] || return 0
  wt=$(cd "$wt" 2>/dev/null && pwd -P || printf '%s\n' "$wt")
  is_git_repo "$wt" || return 0

  local wt_name branch branchref head_sha common_dir default_branch base_ref dirty benign_only non_benign
  local git_index git_head
  local merged_state repo_top origin_url repo_slug status_line upstream_gone
  local pr_row pr_source pr_number pr_state pr_merged_at pr_closed_at pr_url pr_head_ref
  local safe_to_remove=0 removal_candidate=0 allow_force=0 tag removal_reason repo_label line
  local proc_usage tmux_usage recent_age hold_reasons ahead_count

  wt_name=$(basename "$wt")
  repo_top=$(git -C "$wt" rev-parse --show-toplevel 2>/dev/null || true)
  [ -n "$repo_top" ] || return 0

  common_dir=$(git -C "$wt" rev-parse --git-common-dir 2>/dev/null || true)
  [ -n "$common_dir" ] || return 0
  common_dir=$(abspath_from "$common_dir" "$wt")
  [ -n "$common_dir" ] || return 0

  git_index=$(git -C "$wt" rev-parse --git-path index 2>/dev/null || true)
  git_head=$(git -C "$wt" rev-parse --git-path HEAD 2>/dev/null || true)
  [ -n "$git_index" ] && git_index=$(abspath_from "$git_index" "$wt")
  [ -n "$git_head" ] && git_head=$(abspath_from "$git_head" "$wt")

  default_branch=$(git -C "$wt" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|origin/||')
  [ -z "$default_branch" ] && default_branch="main"
  maybe_fetch_repo "$wt" "$common_dir" "$default_branch"

  if git --git-dir="$common_dir" show-ref --verify --quiet "refs/remotes/origin/$default_branch"; then
    base_ref="refs/remotes/origin/$default_branch"
  else
    base_ref="refs/heads/$default_branch"
  fi

  dirty=$(git -C "$wt" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
  if [ "$dirty" != "0" ]; then
    non_benign=$(git -C "$wt" status --porcelain 2>/dev/null \
      | awk '{print $NF}' \
      | grep -Ev "$BENIGN_DIRTY_PATTERNS" | wc -l | tr -d ' ')
    if [ "$non_benign" = "0" ]; then
      benign_only="yes"
    else
      benign_only="no"
    fi
  else
    benign_only="n/a"
  fi

  branchref=$hinted_branchref
  if [ -z "$branchref" ]; then
    branch=$(git -C "$wt" branch --show-current 2>/dev/null || true)
    if [ -n "$branch" ]; then
      branchref="refs/heads/$branch"
    else
      branchref="DETACHED"
    fi
  fi

  if [ "$branchref" = "DETACHED" ]; then
    branch=""
  else
    branch=${branchref#refs/heads/}
  fi

  head_sha=$(git -C "$wt" rev-parse HEAD 2>/dev/null || true)

  if [ -z "$branch" ]; then
    merged_state="detached"
  elif [ -n "$head_sha" ] && git --git-dir="$common_dir" merge-base --is-ancestor "$head_sha" "$base_ref" 2>/dev/null; then
    merged_state="merged"
  else
    merged_state="unmerged"
  fi

  status_line=$(git -C "$wt" status --short --branch 2>/dev/null | sed -n '1p')
  case "$status_line" in
    *"[gone]"*) upstream_gone="yes" ;;
    *) upstream_gone="no" ;;
  esac

  origin_url=$(git -C "$wt" remote get-url origin 2>/dev/null || true)
  repo_slug=$(github_repo_from_origin "$origin_url" 2>/dev/null || true)
  if [ -n "$repo_slug" ]; then
    repo_label=$repo_slug
  else
    repo_label=$(basename "$repo_top")
  fi

  pr_source=""
  pr_number=""
  pr_state=""
  pr_merged_at=""
  pr_closed_at=""
  pr_url=""
  pr_head_ref=""
  pr_row=$(lookup_pr_info "$repo_slug" "$wt_name" "$branch" "$head_sha" 2>/dev/null || true)
  if [ -n "$pr_row" ]; then
    IFS=$'\t' read -r pr_source pr_number pr_state pr_merged_at pr_closed_at pr_url pr_head_ref <<EOF
$pr_row
EOF
  fi

  allow_force=0
  if [ "$dirty" = "0" ] || [ "$benign_only" = "yes" ] || [ "$FORCE_DIRTY" = "1" ]; then
    allow_force=1
  fi

  hold_reasons=""
  proc_usage=$(process_usage_summary "$wt")
  if [ -n "$proc_usage" ]; then
    hold_reasons="${hold_reasons:+$hold_reasons,}proc=$proc_usage"
  fi

  tmux_usage=$(tmux_usage_summary "$wt")
  if [ -n "$tmux_usage" ]; then
    hold_reasons="${hold_reasons:+$hold_reasons,}tmux=$tmux_usage"
  fi

  recent_age=$(recent_activity_age "$wt" "$git_index" "$git_head" || true)
  if [ -n "$recent_age" ]; then
    hold_reasons="${hold_reasons:+$hold_reasons,}recent=$recent_age"
  fi

  ahead_count=0
  if [ -n "$branch" ]; then
    ahead_count=$(ahead_of_upstream_count "$wt")
    if [ "${ahead_count:-0}" -gt 0 ]; then
      hold_reasons="${hold_reasons:+$hold_reasons,}ahead=$ahead_count"
    fi
  fi

  removal_reason=""
  if [ "$pr_state" = "MERGED" ] && [ "$allow_force" = "1" ]; then
    removal_candidate=1
    removal_reason="merged-pr"
  elif [ -z "$pr_state" ] && [ "$merged_state" = "merged" ] && [ "$allow_force" = "1" ]; then
    removal_candidate=1
    removal_reason="git-merged"
  elif [ "$REMOVE_CLOSED" = "1" ] && [ "$pr_state" = "CLOSED" ] && [ -z "$pr_merged_at" ] && [ "$allow_force" = "1" ]; then
    removal_candidate=1
    removal_reason="closed-pr"
  fi

  if [ "$removal_candidate" = "1" ] && [ -z "$hold_reasons" ]; then
    safe_to_remove=1
  fi

  tag="clean"
  if [ "$benign_only" = "yes" ]; then
    tag="benign-dirty"
  elif [ "$FORCE_DIRTY" = "1" ] && [ "$dirty" != "0" ]; then
    tag="forced"
  fi

  line=$(printf '%s\t[%s]\t%s' "$(printf '%s\n' "$wt" | safe_label)" "$repo_label" "$(describe_state "$merged_state" "$pr_state" "$pr_number" "$pr_source" "$upstream_gone")")
  if [ -n "$branch" ]; then
    line="$line branch=$branch"
  fi
  line="$line dirty=$dirty"
  [ -n "$hold_reasons" ] && line="$line hold=$hold_reasons"
  [ -n "$pr_url" ] && line="$line url=$pr_url"

  if [ "$safe_to_remove" = "1" ]; then
    if [ "$DRY_RUN" = "1" ]; then
      printf 'WOULD-REMOVE\t%s\treason=%s\tmode=%s\n' "$line" "$removal_reason" "$tag"
    else
      printf 'REMOVE\t%s\treason=%s\tmode=%s\n' "$line" "$removal_reason" "$tag"
      if [ "$dirty" != "0" ]; then
        git --git-dir="$common_dir" worktree remove --force "$wt" 2>&1 | sed 's|^|  |'
      else
        git --git-dir="$common_dir" worktree remove "$wt" 2>&1 | sed 's|^|  |'
      fi
      if [ -n "$branch" ]; then
        git --git-dir="$common_dir" branch -D "$branch" 2>&1 | sed 's|^|  |'
      fi
    fi
  elif [ "$removal_candidate" = "1" ] && [ -n "$hold_reasons" ]; then
    printf 'BLOCKED\t%s\treason=%s\tmode=%s\n' "$line" "$removal_reason" "$tag"
  elif [ "$pr_state" = "MERGED" ] && [ "$dirty" != "0" ] && [ "$benign_only" != "yes" ] && [ "$FORCE_DIRTY" != "1" ]; then
    printf 'MERGED-BUT-DIRTY\t%s\n' "$line"
  elif [ "$pr_state" = "CLOSED" ] && [ -z "$pr_merged_at" ]; then
    printf 'REVIEW-CLOSED\t%s\tmode=%s\n' "$line" "$tag"
  elif [ "$merged_state" = "merged" ] && [ "$dirty" != "0" ] && [ "$benign_only" != "yes" ] && [ "$FORCE_DIRTY" != "1" ]; then
    printf 'MERGED-BUT-DIRTY\t%s\n' "$line"
  elif [ "$merged_state" = "detached" ]; then
    printf 'DETACHED\t%s\n' "$line"
  else
    printf 'KEEP\t%s\n' "$line"
  fi

  maybe_prune_repo "$common_dir"
}

sweep_repo() {
  local repo_dir=$1
  local repo_top
  local wt branchref

  repo_top=$(git -C "$repo_dir" rev-parse --show-toplevel 2>/dev/null || printf '%s\n' "$repo_dir")

  git -C "$repo_dir" worktree list --porcelain | awk '
    /^worktree / {wt=$2}
    /^branch / {br=$2; print wt "\t" br}
    /^detached/ {print wt "\tDETACHED"}
  ' | while IFS=$'\t' read -r wt branchref; do
    [ "$wt" = "$repo_top" ] && continue
    inspect_worktree "$wt" "$branchref"
  done
}

sweep_root() {
  local root=$1
  local wt
  [ -d "$root" ] || return 0

  find "$root" -mindepth 1 -maxdepth 1 -type d -print | while IFS= read -r wt; do
    is_linked_worktree_dir "$wt" || continue
    inspect_worktree "$wt"
  done
}

while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --force-dirty)
      FORCE_DIRTY=1
      shift
      ;;
    --remove-closed)
      REMOVE_CLOSED=1
      shift
      ;;
    --discover)
      DISCOVER=1
      shift
      ;;
    --maxdepth)
      DISCOVER_MAXDEPTH=${2:-5}
      shift 2
      ;;
    --recent-hours)
      RECENT_HOURS=${2:-24}
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      ARGS+=("$1")
      shift
      ;;
  esac
done

if [ "$DISCOVER" = "1" ]; then
  if [ ${#ARGS[@]} -eq 0 ]; then
    ARGS=("$HOME_DIR")
  fi
  while IFS= read -r root; do
    [ -n "$root" ] && printf '%s\n' "$root"
  done < <(discover_roots "${ARGS[@]}") | while IFS= read -r root; do
    sweep_root "$root"
  done
  exit 0
fi

if [ ${#ARGS[@]} -eq 0 ]; then
  if is_git_repo "$(pwd)"; then
    ARGS=("$(pwd)")
  else
    [ -d "$HOME_DIR/.codex-worktrees" ] && ARGS+=("$HOME_DIR/.codex-worktrees")
    [ -d "$HOME_DIR/.claude-worktrees" ] && ARGS+=("$HOME_DIR/.claude-worktrees")
  fi
fi

if [ ${#ARGS[@]} -eq 0 ]; then
  echo "No repos or worktree roots found."
  exit 0
fi

populate_process_cwds
populate_tmux_panes

for target in "${ARGS[@]}"; do
  if is_git_repo "$target"; then
    sweep_repo "$target"
  elif [ -d "$target" ]; then
    sweep_root "$target"
  else
    echo "SKIP: $target (not a git repo or directory root)"
  fi
done
