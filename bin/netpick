#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""netpick: which network should this Mac use right now?

It measures each candidate link with every probe bound to that link's
interface, ranks the links for a workload of about 30 Claude Code sessions,
Subfleet lanes and git, prints a table and a recommendation, and appends each
measurement to a JSONL history. It never switches networks: only Max's clicks
in the Wi-Fi menu, or plugging in a tether, move the route.

    netpick                   measure the live links (Wi-Fi plus any tether or
                              Ethernet, at the same moment) and recommend one
    netpick watch --baseline  measure this Wi-Fi network, then each new one Max
                              picks in the Wi-Fi menu (waits for a portal sign-in)
    netpick history           past measurements (--rank, --by-network)
    netpick import FILE...    load nettest.sh captures into the history
    netpick name ID NAME      give a network a friendly name
    netpick interfaces        list the candidate links without measuring

Design, ranking rule, data budget and the field notes behind them:
docs/netpick.md. Stdlib only; macOS only for measuring.
"""
from __future__ import annotations

import argparse
import concurrent.futures
import dataclasses
import datetime as dt
import fcntl
import hashlib
import ipaddress
import json
import math
import os
import re
import socket
import statistics
import struct
import subprocess
import sys
import time
from pathlib import Path

VERSION = "0.1.0"
SCHEMA = 1

HOSTS = ("api.anthropic.com", "github.com")
FALLBACK_IPS = {"api.anthropic.com": "160.79.104.10", "github.com": "140.82.112.3"}
PING_TARGET = "1.1.1.1"
CAPTIVE_URL = "http://captive.apple.com/hotspot-detect.html"
IPINFO_URL = "https://ipinfo.io/json"
STREAM_DOWN_URL = "https://speed.cloudflare.com/__down?bytes={n}"
STREAM_UP_URL = "https://speed.cloudflare.com/__up"
IP_BOUND_IF = 25  # <netinet/in.h> in the macOS 26 SDK: bind a socket to one interface

NQ_SAFETY = 2.0  # assume networkQuality moves this many times the one-stream rate
NQ_MIN_SECONDS = 5  # a shorter networkQuality run says little; skip it instead
NQ_BLIND_SECONDS = 8  # run length when no transfer estimate exists


@dataclasses.dataclass
class Options:
    pings: int = 40
    ping_interval: float = 0.25
    conns: int = 4  # per host, so 8 per link by default
    dns_tries: int = 2  # per host
    stream: bool = True
    stream_down_mb: float = 5.0
    stream_up_mb: float = 2.5
    stream_seconds: float = 8.0
    nq: bool = True
    nq_seconds: int = 20
    budget_mb: float = 100.0


# ---------------------------------------------------------------- commands
# netpick runs only these read-only commands, and every probe names its
# interface. It never joins or leaves Wi-Fi (on 2026-11-04 a command-line join
# of the WPA3 Pixel hotspot failed with -3900 and left the Mac offline for about
# 90 s), never changes the service order or any other setting, reads no
# keychain item, and kills only its own child processes, by pid.

IFACE_RE = re.compile(r"en\d{1,3}")
TOOL_PATHS = {
    "ping": "/sbin/ping",
    "curl": "/usr/bin/curl",
    "networkQuality": "/usr/bin/networkQuality",
    "netstat": "/usr/sbin/netstat",
    "ipconfig": "/usr/sbin/ipconfig",
    "networksetup": "/usr/sbin/networksetup",
    "route": "/sbin/route",
    "osascript": "/usr/bin/osascript",
}

# Reads Wi-Fi link stats through CoreWLAN; it calls no method that changes
# anything. SSIDs come back redacted on macOS 26, so it does not ask for one.
WLAN_JXA = """ObjC.import('CoreWLAN');
function run(argv) {
  var i = $.CWWiFiClient.sharedWiFiClient.interfaceWithName($(argv[0]));
  if (!i || i.isNil()) { return 'null'; }
  var ch = i.wlanChannel, has = !!ch && !ch.isNil();
  return JSON.stringify({rssi: Number(i.rssiValue), noise: Number(i.noiseMeasurement),
    tx_rate: Number(i.transmitRate), channel: has ? Number(ch.channelNumber) : null,
    band: has ? Number(ch.channelBand) : null, width: has ? Number(ch.channelWidth) : null,
    security: Number(i.security)});
}"""


class UnsafeCommand(RuntimeError):
    """A command outside netpick's read-only allowlist."""


def _is_iface(value) -> bool:
    return isinstance(value, str) and IFACE_RE.fullmatch(value) is not None


def _iface_after(argv, flag) -> bool:
    try:
        return _is_iface(argv[argv.index(flag) + 1])
    except (ValueError, IndexError):
        return False


def _ipconfig_ok(a) -> bool:
    if len(a) == 3:
        return a[1] in ("getifaddr", "getsummary") and _is_iface(a[2])
    return len(a) == 4 and a[1] == "getoption" and _is_iface(a[2]) and a[3] == "domain_name_server"


READ_ONLY = {
    # probes: each one bound to a single interface
    "ping": lambda a: _iface_after(a, "-b"),
    "curl": lambda a: _iface_after(a, "--interface"),
    "networkQuality": lambda a: _iface_after(a, "-I"),
    # reads of routes, addresses, byte counters and Wi-Fi link stats
    "netstat": lambda a: a[1:] == ["-rn", "-f", "inet"]
    or (len(a) == 4 and a[1:3] == ["-ibn", "-I"] and _is_iface(a[3])),
    "ipconfig": _ipconfig_ok,
    "networksetup": lambda a: a[1:] == ["-listallhardwareports"],
    "route": lambda a: a[1:] == ["-n", "get", "default"],
    "osascript": lambda a: len(a) == 6 and a[1:5] == ["-l", "JavaScript", "-e", WLAN_JXA] and _is_iface(a[5]),
}


def check_command(argv) -> None:
    argv = [str(x) for x in argv]
    rule = READ_ONLY.get(argv[0]) if argv else None
    if rule is None or not rule(argv):
        raise UnsafeCommand("netpick refuses to run: " + " ".join(argv[:4]))


@dataclasses.dataclass
class Proc:
    rc: int
    out: str = ""
    err: str = ""
    seconds: float = 0.0
    stopped: str | None = None  # "timeout" or "budget" when netpick ended it early


def _text(b) -> str:
    if b is None:
        return ""
    return b.decode("utf-8", "replace") if isinstance(b, bytes) else str(b)


class Runner:
    """Runs the allowlisted commands by absolute path. Tests swap in a fake."""

    def run(self, argv, timeout, stdin=None) -> Proc:
        check_command(argv)
        exe = [TOOL_PATHS[argv[0]], *argv[1:]]
        feed = {"input": stdin} if stdin is not None else {"stdin": subprocess.DEVNULL}
        t0 = time.monotonic()
        try:
            p = subprocess.run(exe, capture_output=True, timeout=timeout, **feed)
        except subprocess.TimeoutExpired as e:  # subprocess.run has killed the child
            return Proc(-9, _text(e.stdout), _text(e.stderr), time.monotonic() - t0, "timeout")
        except OSError as e:
            return Proc(127, "", str(e), time.monotonic() - t0)
        return Proc(p.returncode, _text(p.stdout), _text(p.stderr), time.monotonic() - t0)

    def run_watched(self, argv, timeout, should_stop, poll=0.5) -> Proc:
        """Run argv, asking should_stop(elapsed) every poll seconds; a reason
        string ends the run. Killing loses networkQuality's output (it prints
        nothing on SIGINT or SIGTERM), so this is a backstop, not the plan."""
        check_command(argv)
        exe = [TOOL_PATHS[argv[0]], *argv[1:]]
        t0 = time.monotonic()
        try:
            p = subprocess.Popen(exe, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        except OSError as e:
            return Proc(127, "", str(e), 0.0)
        stopped = None
        while True:
            try:
                out, err = p.communicate(timeout=poll)
                break
            except subprocess.TimeoutExpired:
                elapsed = time.monotonic() - t0
                stopped = "timeout" if elapsed >= timeout else should_stop(elapsed)
                if stopped:
                    p.kill()  # netpick's own child, by pid
                    try:
                        out, err = p.communicate(timeout=1)
                    except subprocess.TimeoutExpired:  # a grandchild still holds the pipes
                        p.stdout.close()
                        p.stderr.close()
                        p.wait()
                        out, err = b"", b""
                    break
        return Proc(p.returncode, _text(out), _text(err), time.monotonic() - t0, stopped)


# ---------------------------------------------------------------- parsers

_IPV4 = re.compile(r"(?:\d{1,3}\.){3}\d{1,3}")


def _is_ipv4(s) -> bool:
    return isinstance(s, str) and _IPV4.fullmatch(s) is not None and all(int(p) < 256 for p in s.split("."))


def _finite(x):
    if isinstance(x, bool) or not isinstance(x, (int, float)):
        return None
    return float(x) if math.isfinite(x) else None


PING_COUNTS = re.compile(
    r"(\d+) packets transmitted, (\d+) (?:packets )?received(?:, \+(\d+) duplicates)?, (-?[\d.]+)% packet loss"
)
PING_RTT = re.compile(r"round-trip min/avg/max/(?:stddev|std-dev) = ([\d.]+)/([\d.]+)/([\d.]+)/([\d.]+) ms")


def parse_ping(text):
    """macOS ping summary -> {sent, received, loss_pct, min/avg/max/stddev_ms}."""
    m = PING_COUNTS.search(text or "")
    if not m:
        return None
    out = {"sent": int(m[1]), "received": int(m[2]), "loss_pct": min(max(float(m[4]), 0.0), 100.0)}
    r = PING_RTT.search(text)
    if r and out["received"]:
        out.update(min_ms=float(r[1]), avg_ms=float(r[2]), max_ms=float(r[3]), stddev_ms=float(r[4]))
    return out


_RATE_UNIT = {"bps": 1e-6, "Kbps": 1e-3, "Mbps": 1.0, "Gbps": 1e3}
NQ_CAP = re.compile(r"^\s*(Uplink|Downlink) capacity: ([\d.]+) (bps|Kbps|Mbps|Gbps)", re.M)
NQ_RESP = re.compile(r"^\s*Responsiveness: (\w+) \(([\d.]+) (milliseconds|seconds) \| ([\d.]+) RPM\)", re.M)
NQ_RESP_RPM = re.compile(r"^\s*Responsiveness: (\w+) \(([\d.]+) RPM\)", re.M)
NQ_IDLE = re.compile(r"^\s*Idle Latency: ([\d.]+) (milliseconds|seconds)", re.M)


def parse_nq_text(text):
    """networkQuality's human summary (as nettest.sh captured it) -> metrics."""
    text = text or ""
    if "==== SUMMARY ====" in text:
        text = text.split("==== SUMMARY ====", 1)[1]
    out = {}
    for which, value, unit in NQ_CAP.findall(text):
        out["up_mbps" if which == "Uplink" else "down_mbps"] = round(float(value) * _RATE_UNIT[unit], 3)
    m = NQ_RESP.search(text)
    if m:
        out["rpm"] = float(m[4])
        out["responsiveness"] = m[1]
    else:
        m = NQ_RESP_RPM.search(text)
        if m:
            out["rpm"] = float(m[2])
            out["responsiveness"] = m[1]
    m = NQ_IDLE.search(text)
    if m:
        out["base_rtt_ms"] = float(m[1]) * (1000.0 if m[2] == "seconds" else 1.0)
    return out or None


def parse_nq_json(text):
    """networkQuality -c output -> {down_mbps, up_mbps, rpm, base_rtt_ms, bytes, seconds}."""
    try:
        j = json.loads(text or "")
    except ValueError:
        return None
    if not isinstance(j, dict):
        return None

    def mbps(key):
        v = _finite(j.get(key))
        return round(v / 1e6, 3) if v is not None else None

    out = {"down_mbps": mbps("dl_throughput"), "up_mbps": mbps("ul_throughput"), "rpm": _finite(j.get("responsiveness"))}
    if out["rpm"] is not None:
        out["rpm"] = round(out["rpm"], 1)
    base = _finite(j.get("base_rtt"))
    out["base_rtt_ms"] = round(base, 1) if base is not None else None
    moved = [j.get(k) for k in ("dl_bytes_transferred", "ul_bytes_transferred") if _finite(j.get(k)) is not None]
    out["bytes"] = int(sum(moved)) if moved else None
    durations = [_finite(j.get(k)) for k in ("dl_phase_duration", "ul_phase_duration")]
    durations = [d for d in durations if d is not None]
    out["seconds"] = round(max(durations), 1) if durations else None
    kinds = (j.get("other") or {}).get("interface-type") if isinstance(j.get("other"), dict) else None
    if isinstance(kinds, dict) and kinds:
        out["interface_type"] = max(kinds, key=lambda k: kinds[k])
    if out["down_mbps"] is None and out["up_mbps"] is None:
        out["error"] = str(j.get("error_code") or j.get("error") or "no throughput in output")
    return out


def parse_default_routes(text):
    """`netstat -rn -f inet` -> {iface: {gateway, flags}} for default routes,
    the first per interface. Non-primary links carry a scoped (I) route."""
    routes, netif = {}, 3
    for line in (text or "").splitlines():
        f = line.split()
        if not f:
            continue
        if f[0] == "Destination" and "Netif" in f:
            netif = f.index("Netif")
            continue
        if f[0] != "default" or len(f) <= netif or f[netif] in routes:
            continue
        routes[f[netif]] = {"gateway": f[1] if _is_ipv4(f[1]) else None, "flags": f[2]}
    return routes


def parse_if_bytes(text, iface):
    """`netstat -ibn -I <if>` -> (bytes in, bytes out) from the link-layer row.
    Read from the right, because the Address column can be empty."""
    for line in (text or "").splitlines():
        f = line.split()
        if len(f) >= 9 and f[0] == iface and f[2].startswith("<Link#"):
            try:
                return int(f[-5]), int(f[-2])
            except ValueError:
                return None
    return None


def parse_hardware_ports(text):
    """`networksetup -listallhardwareports` -> {device: port name}."""
    ports, port = {}, None
    for line in (text or "").splitlines():
        if line.startswith("Hardware Port:"):
            port = line.split(":", 1)[1].strip()
        elif line.startswith("Device:") and port is not None:
            ports[line.split(":", 1)[1].strip()] = port
            port = None
    return ports


def parse_summary(text):
    """`ipconfig getsummary <if>` -> {security, interfacetype}. SSID and BSSID are redacted."""
    out = {}
    for key in ("Security", "InterfaceType"):
        m = re.search(rf"^\s*{key} : (.+?)\s*$", text or "", re.M)
        if m:
            out[key.lower()] = m[1]
    return out


def parse_ipinfo(text):
    try:
        j = json.loads(text or "")
    except ValueError:
        return None
    if not isinstance(j, dict) or not isinstance(j.get("ip"), str):
        return None
    return {k: j[k] for k in ("ip", "org", "city", "region", "country") if isinstance(j.get(k), str)}


def parse_curl_w(text):
    """'%{exitcode} %{http_code} %{time_connect} %{time_appconnect}' -> dict."""
    f = (text or "").split()
    if len(f) != 4:
        return None
    try:
        return {"exit": int(f[0]), "http_code": f[1], "connect_s": float(f[2]), "tls_s": float(f[3])}
    except ValueError:
        return None


def parse_stream_w(text):
    """'%{exitcode} %{size_download} %{speed_download} %{size_upload} %{speed_upload} %{time_total}'."""
    f = (text or "").split()
    if len(f) != 6:
        return None
    try:
        return {
            "exit": int(f[0]),
            "size_download": int(float(f[1])),
            "speed_download": float(f[2]),
            "size_upload": int(float(f[3])),
            "speed_upload": float(f[4]),
            "time_total": float(f[5]),
        }
    except ValueError:
        return None


# CoreWLAN enums, from CoreWLANTypes.h in the macOS 26 SDK
CW_SECURITY = {
    0: "None", 1: "WEP", 2: "WPA Personal", 3: "WPA Personal Mixed", 4: "WPA2 Personal", 5: "Personal",
    6: "Dynamic WEP", 7: "WPA Enterprise", 8: "WPA Enterprise Mixed", 9: "WPA2 Enterprise", 10: "Enterprise",
    11: "WPA3 Personal", 12: "WPA3 Enterprise", 13: "WPA3 Transition", 14: "OWE", 15: "OWE Transition",
}
CW_BAND = {1: "2.4GHz", 2: "5GHz", 3: "6GHz"}
CW_WIDTH_MHZ = {1: 20, 2: 40, 3: 80, 4: 160}


def parse_wlan_json(text):
    try:
        j = json.loads(text or "")
    except ValueError:
        return None
    if not isinstance(j, dict):
        return None
    out = {}
    for key in ("rssi", "noise", "tx_rate", "channel"):
        v = _finite(j.get(key))
        if v is not None:
            out[key] = int(v) if v == int(v) else v
    if CW_BAND.get(j.get("band")):
        out["band"] = CW_BAND[j["band"]]
    if CW_WIDTH_MHZ.get(j.get("width")):
        out["width_mhz"] = CW_WIDTH_MHZ[j["width"]]
    if j.get("security") in CW_SECURITY:
        out["security"] = CW_SECURITY[j["security"]]
    return out


WIFI_FIELD = re.compile(r"^\s*(Channel|Security|Signal / Noise|Transmit Rate): (.*?)\s*$")


def parse_wifi_link(line):
    """nettest.sh's 'wifi link:' line (system_profiler fields joined by ';').
    Only fields that start a segment count: an unanchored grep for 'Channel'
    also caught the long 'Supported Channels:' list (Starbucks, 11/05)."""
    out = {}
    for seg in (line or "").split(";"):
        m = WIFI_FIELD.match(seg)
        if not m:
            continue
        key, val = m.groups()
        if key == "Channel" and "channel" not in out:
            mm = re.match(r"(\d+)\s*\((\d+(?:\.\d+)?)GHz(?:,\s*(\d+)MHz)?\)", val)
            if mm:
                out["channel"] = int(mm[1])
                out["band"] = "2.4GHz" if mm[2] in ("2", "2.4") else mm[2] + "GHz"
                if mm[3]:
                    out["width_mhz"] = int(mm[3])
        elif key == "Security" and "security" not in out:
            out["security"] = val
        elif key == "Signal / Noise" and "rssi" not in out:
            mm = re.match(r"(-?\d+) dBm / (-?\d+) dBm", val)
            if mm:
                out["rssi"], out["noise"] = int(mm[1]), int(mm[2])
        elif key == "Transmit Rate" and "tx_rate" not in out:
            mm = re.match(r"\d+(?:\.\d+)?", val)
            if mm:
                out["tx_rate"] = float(mm[0]) if "." in mm[0] else int(mm[0])
    return out


def security_class(s):
    """Group the many spellings (getsummary WPA2_PSK, system_profiler 'WPA2
    Personal', CoreWLAN names) into open / wep / wpa / wpa2 / wpa3 / enterprise."""
    if not s:
        return None
    u = str(s).upper()
    if "ENTERPRISE" in u or "EAP" in u or "802.1X" in u:
        return "enterprise"
    if "WPA3" in u or "SAE" in u:
        return "wpa3"
    if "WPA2" in u:
        return "wpa2"
    if "WPA" in u:
        return "wpa"
    if "WEP" in u:
        return "wep"
    if "OWE" in u or "NONE" in u or "OPEN" in u:
        return "open"
    return re.sub(r"[^a-z0-9]+", "", str(s).lower()) or None


def dns_query_packet(qid, name) -> bytes:
    labels = b"".join(bytes([len(p)]) + p.encode("ascii") for p in name.rstrip(".").split("."))
    return struct.pack(">HHHHHH", qid, 0x0100, 1, 0, 0, 0) + labels + b"\x00" + struct.pack(">HH", 1, 1)


def dns_parse_response(data, qid):
    """(rcode, answer count) when data is a reply to query qid, else None."""
    if len(data) < 12:
        return None
    rid, flags, _qd, answers = struct.unpack(">HHHH", data[:8])
    if rid != qid or not flags & 0x8000:
        return None
    return flags & 0x000F, answers


def dns_lookup(server, name, iface, timeout=3.0, port=53):
    """One A query to server with the socket bound to iface -> (ok, ms, detail).
    The connection probes pin IPs with --resolve so they time the link alone;
    this is the one check that includes the network's own DNS."""
    qid = int.from_bytes(os.urandom(2), "big")
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        sock.setsockopt(socket.IPPROTO_IP, IP_BOUND_IF, socket.if_nametoindex(iface))
        t0 = time.monotonic()
        deadline = t0 + timeout
        sock.sendto(dns_query_packet(qid, name), (server, port))
        while True:
            left = deadline - time.monotonic()
            if left <= 0:
                return False, None, "timeout"
            sock.settimeout(left)
            data, addr = sock.recvfrom(4096)
            got = dns_parse_response(data, qid) if addr[0] == server else None
            if got is None:
                continue
            rcode, answers = got
            ms = round((time.monotonic() - t0) * 1000, 1)
            if rcode == 0 and answers > 0:
                return True, ms, "ok"
            return False, ms, f"rcode {rcode}" if rcode else "no answer"
    except TimeoutError:
        return False, None, "timeout"
    except OSError as e:
        return False, None, e.strerror or str(e)
    finally:
        sock.close()


def system_resolve(host):
    """The primary network's answer for host, if it is a public address. A
    captive portal's DNS can answer with a private one; then the caller falls
    back to a known address so other links are not tested against the portal."""
    try:
        infos = socket.getaddrinfo(host, 443, socket.AF_INET, socket.SOCK_STREAM)
    except OSError:
        return None
    for info in infos:
        ip = info[4][0]
        try:
            if ipaddress.ip_address(ip).is_global:
                return ip
        except ValueError:
            continue
    return None


# ---------------------------------------------------------------- records


def utc_stamp(ts) -> str:
    return dt.datetime.fromtimestamp(ts, dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_stamp(s):
    try:
        return dt.datetime.fromisoformat(s).timestamp()
    except (TypeError, ValueError):
        return None


def network_id(rec) -> str:
    """Stable id without an SSID: a Wi-Fi network is its gateway and security
    class; a tether or Ethernet link is its hardware port."""
    if rec.get("kind") == "wifi":
        basis = f"wifi|{rec.get('gateway') or '?'}|{rec.get('security_class') or '?'}"
    else:
        basis = f"wired|{rec.get('port') or rec.get('interface') or '?'}"
    return hashlib.sha256(basis.encode()).hexdigest()[:8]


def short_org(org, width=30):
    if not org:
        return None
    return org if len(org) <= width else org[: width - 1] + "…"


def make_label(rec) -> str:
    if rec.get("kind") == "wifi":
        sec = (rec.get("security_class") or "?").upper()
        base = f"Wi-Fi {sec} gw {rec.get('gateway') or '?'}"
    else:
        base = rec.get("port") or rec.get("interface") or "?"
    org = short_org((rec.get("egress") or {}).get("org"))
    return f"{base} · {org}" if org else base


def display_name(rec, names=None) -> str:
    return (names or {}).get(rec.get("network_id")) or rec.get("label") or make_label(rec)


def compute_metrics(rec) -> dict:
    """The ranking inputs. A missing probe gives None, which ranks worst."""
    conns = rec.get("conns") or {}
    att, ok = conns.get("attempted") or 0, conns.get("ok") or 0
    ping = rec.get("ping") or {}
    sent, recv = ping.get("sent") or 0, ping.get("received") or 0
    loss = _finite(ping.get("loss_pct")) if sent else None
    latency = None
    if recv and _finite(ping.get("avg_ms")) is not None:
        latency = ping["avg_ms"] + (_finite(ping.get("stddev_ms")) or 0.0)
    if sent and not recv and ok:  # ICMP blocked while HTTPS works: loss says nothing
        loss = None
    nq, st = rec.get("nq") or {}, rec.get("stream") or {}
    up, down = _finite(nq.get("up_mbps")), _finite(nq.get("down_mbps"))
    srcs = {"nq" if up is not None else None, "nq" if down is not None else None}
    if up is None and _finite(st.get("up_mbps")) is not None:
        up = _finite(st.get("up_mbps"))
        srcs.add("stream")
    if down is None and _finite(st.get("down_mbps")) is not None:
        down = _finite(st.get("down_mbps"))
        srcs.add("stream")
    srcs.discard(None)
    via = srcs.pop() if len(srcs) == 1 else ("mixed" if srcs else None)
    return {
        "conn_ratio": ok / att if att else None,
        "loss_pct": loss,
        "latency_ms": round(latency, 1) if latency is not None else None,
        "up_mbps": up,
        "down_mbps": down,
        "rpm": _finite(nq.get("rpm")),
        "via": via,
    }


def finalize(rec, names=None) -> dict:
    if rec.get("kind") == "wifi":
        rec["security_class"] = security_class(rec.get("security"))
    rec["network_id"] = network_id(rec)
    rec["label"] = make_label(rec)
    if names and names.get(rec["network_id"]):
        rec["name"] = names[rec["network_id"]]
    st, nq = rec.get("stream") or {}, rec.get("nq") or {}
    rec["data_bytes"] = int((st.get("bytes") or 0) + (nq.get("bytes") or 0))
    rec["metrics"] = compute_metrics(rec)
    return rec


CAP_HEAD = re.compile(r"^### (\S+) on (\S+)\s+(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ)", re.M)
CAP_IP = re.compile(r"^ip: (\S*)\s+default via: (\S*)", re.M)
CAP_CAPTIVE = re.compile(r"^captive check: (\d+)", re.M)
CAP_CONNS = re.compile(r"^api (\d+)/(\d+), github (\d+)/(\d+) connected; TLS done at: (.*?)\s*s?\s*$", re.M)


def parse_capture(text, source=None):
    """A nettest.sh capture (2026-11-04/05 scripts) -> a history record."""
    head = CAP_HEAD.search(text or "")
    if not head:
        return None
    label, iface, when = head.groups()
    ipm = CAP_IP.search(text)
    wifi_line = re.search(r"^wifi link: (.*)$", text, re.M)
    wifi = parse_wifi_link(wifi_line[1]) if wifi_line else None
    rec = {
        "v": SCHEMA,
        "time": when,
        "run": "import-" + hashlib.sha256(text.encode()).hexdigest()[:8],
        "mode": "import",
        "source": source,
        "source_label": label,
        "interface": iface,
        "kind": "wifi" if wifi_line else "wired",
        "port": "Wi-Fi" if wifi_line else iface,
        "primary": None,
        "ip": (ipm[1] or None) if ipm else None,
        "gateway": (ipm[2] or None) if ipm else None,
        "security": (wifi or {}).get("security"),
        "wifi": {k: v for k, v in (wifi or {}).items() if k != "security"} or None,
        "egress": None,
        "notes": [],
    }
    cap = CAP_CAPTIVE.search(text)
    rec["ping"] = parse_ping(text)
    cm = CAP_CONNS.search(text)
    if cm:
        api_ok, api_n, gh_ok, gh_n = (int(x) for x in cm.groups()[:4])
        times = [float(t) for t in cm[5].split() if re.fullmatch(r"[\d.]+", t)]
        rec["conns"] = {
            "attempted": api_n + gh_n,
            "ok": api_ok + gh_ok,
            "by_host": {HOSTS[0]: [api_ok, api_n], HOSTS[1]: [gh_ok, gh_n]},
            "tls_s": times,
            "failures": [],
        }
    rec["nq"] = parse_nq_text(text)
    rec["online"] = (cap[1] == "1") if cap else bool(rec.get("conns", {}).get("ok"))
    return finalize(rec)


# ---------------------------------------------------------------- ranking
# Priority order, from the workload (many Claude Code sessions, Subfleet
# lanes, git) and the field notes in docs/netpick.md:
#   1. share of new HTTPS connections that completed: on 11/04 a USB tether
#      with clean pings failed about half of them and was unusable
#   2. ping loss   3. latency (ping avg + 1 sd, so spikes count)
#   4. upload (sessions upload large contexts)   5. download
# Each metric first counts in coarse bands, so a difference inside one test's
# noise cannot outvote a real difference further down the list. Exact values
# then break ties in the same order, and networkQuality responsiveness last.

CONN_CUTS = (1.0, 0.85, 0.6)  # share completed; higher is better
LOSS_CUTS = (2.5, 7.5, 15.0)  # % lost; with 40 pings one loss is 2.5%
LATENCY_CUTS = (100.0, 250.0, 500.0)  # ms
UP_CUTS = (20.0, 8.0, 3.0, 1.0)  # Mbps; higher is better
DOWN_CUTS = (20.0, 8.0, 3.0, 1.0)
RANK_FIELDS = ("conn_ratio", "loss_pct", "latency_ms", "up_mbps", "down_mbps")
KEY_FIELDS = RANK_FIELDS + RANK_FIELDS + ("rpm",)  # the metric behind each key position
FIELD_WORDS = {
    "conn_ratio": "connection success",
    "loss_pct": "packet loss",
    "latency_ms": "latency",
    "up_mbps": "upload",
    "down_mbps": "download",
    "rpm": "responsiveness",
}


def band_high(x, cuts) -> int:
    """Band of a higher-is-better value: 0 is best; missing is worst."""
    if x is None:
        return len(cuts)
    for i, cut in enumerate(cuts):
        if x >= cut:
            return i
    return len(cuts)


def band_low(x, cuts) -> int:
    """Band of a lower-is-better value: 0 is best; missing is worst."""
    if x is None:
        return len(cuts)
    for i, cut in enumerate(cuts):
        if x <= cut:
            return i
    return len(cuts)


def rank_key(m) -> tuple:
    """Smaller sorts first. Every position is monotone in its metric."""
    c, loss, lat, up, down, rpm = (
        _finite((m or {}).get(k)) for k in ("conn_ratio", "loss_pct", "latency_ms", "up_mbps", "down_mbps", "rpm")
    )

    def hi(x):
        return -x if x is not None else math.inf

    def lo(x):
        return x if x is not None else math.inf

    return (
        band_high(c, CONN_CUTS),
        band_low(loss, LOSS_CUTS),
        band_low(lat, LATENCY_CUTS),
        band_high(up, UP_CUTS),
        band_high(down, DOWN_CUTS),
        hi(c),
        lo(loss),
        lo(lat),
        hi(up),
        hi(down),
        hi(rpm),
    )


def rank(records, metrics=None) -> list:
    """Best first. Python's sort is stable, so exact ties keep input order."""
    get = metrics or (lambda r: r.get("metrics") or {})
    return sorted(records, key=lambda r: rank_key(get(r)))


def deciding(a, b):
    """(field, banded) at the first key position where metrics a and b differ."""
    for i, (x, y) in enumerate(zip(rank_key(a), rank_key(b))):
        if x != y:
            return KEY_FIELDS[i], i < len(RANK_FIELDS)
    return None


def fmt_rate(x) -> str:
    if x is None:
        return "—"
    return f"{x:.0f}" if x >= 10 else f"{x:.1f}"


def describe(field, rec) -> str:
    m = rec.get("metrics") or {}
    c = rec.get("conns") or {}
    if field == "conn_ratio":
        return f"{c.get('ok', 0)}/{c.get('attempted', 0)} connections" if c.get("attempted") else "no connection test"
    if field == "loss_pct":
        return "loss unknown" if m.get("loss_pct") is None else f"{m['loss_pct']:.1f}% loss"
    if field == "latency_ms":
        return "latency unknown" if m.get("latency_ms") is None else f"~{m['latency_ms']:.0f} ms"
    if field in ("up_mbps", "down_mbps"):
        word = "up" if field == "up_mbps" else "down"
        return f"{fmt_rate(m.get(field))} Mbps {word}"
    return "responsiveness unknown" if m.get("rpm") is None else f"{m['rpm']:.0f} RPM"


def how_to_switch(best, current) -> str:
    if best.get("kind") == "wifi" and current.get("kind") == "wifi":
        return "Pick it in the Wi-Fi menu; netpick never joins or leaves a network."
    if best.get("kind") != "wifi" and current.get("kind") == "wifi":
        return (
            f"{best.get('port') or best.get('interface')} is up, but macOS routes over Wi-Fi now. Turn Wi-Fi "
            "off in the menu bar, or move that service above Wi-Fi in the service order (System Settings > "
            "Network); netpick changes neither."
        )
    if best.get("kind") == "wifi" and current.get("kind") != "wifi":
        return f"Turn off or unplug {current.get('port') or current.get('interface')}; traffic then falls back to Wi-Fi."
    return "Make it the primary route; netpick never switches networks."


def recommend(ranked, current=None, names=None) -> dict:
    """What to do, given links ranked best first and the one carrying traffic
    now. It says switch only when the winner beats the current link at band
    level, so one test's noise never moves 30 sessions."""
    online = [r for r in ranked if r.get("online")]
    if not online:
        return {
            "action": "none",
            "pick": None,
            "text": "No link reached the internet. If a captive portal is up, sign in, then run netpick again.",
        }
    best = online[0]

    def name(r):
        return display_name(r, names)

    if current is None:
        return {"action": "use", "pick": best, "text": f"Best link: {name(best)}."}
    if not current.get("online"):
        return {
            "action": "switch",
            "pick": best,
            "text": f"Switch to {name(best)}: {name(current)} has no internet. {how_to_switch(best, current)}",
        }
    if best is current:
        others = [r for r in online if r is not best]
        if not others:
            return {"action": "stay", "pick": best, "text": f"Stay on {name(best)} (the only link measured)."}
        d = deciding(best["metrics"], others[0]["metrics"])
        why = f" It beats {name(others[0])} on {FIELD_WORDS[d[0]]}" if d else " It ties"
        detail = f" ({describe(d[0], best)} vs {describe(d[0], others[0])})." if d else f" with {name(others[0])}."
        return {"action": "stay", "pick": best, "text": f"Stay on {name(best)}.{why}{detail}"}
    d = deciding(best["metrics"], current["metrics"])
    if d and d[1]:
        return {
            "action": "switch",
            "pick": best,
            "text": (
                f"Switch to {name(best)}: {describe(d[0], best)} vs {describe(d[0], current)} "
                f"on {name(current)}. {how_to_switch(best, current)}"
            ),
        }
    if d is None:
        return {"action": "stay", "pick": current, "text": f"Stay on {name(current)}: {name(best)} ties with it."}
    return {
        "action": "stay",
        "pick": current,
        "text": (
            f"Stay on {name(current)}: {name(best)} measured only slightly better on {FIELD_WORDS[d[0]]}, "
            "within one test's noise."
        ),
    }


# ---------------------------------------------------------------- budget


def nq_plan(opts, used_bytes, stream):
    """networkQuality -M seconds that keep this link's run inside the data
    budget, or (None, why). 6 s on venue Wi-Fi moved 130 MB on 11/05, so a
    time limit alone does not cap data; the plan assumes networkQuality moves
    NQ_SAFETY times the bounded transfer's one-stream rate."""
    if not opts.nq:
        return None, "off"
    remaining = opts.budget_mb * 1e6 - used_bytes
    if remaining <= 0:
        return None, f"skipped: the {opts.budget_mb:g} MB budget is used up"
    st = stream or {}
    mbps = (_finite(st.get("down_mbps")) or 0.0) + (_finite(st.get("up_mbps")) or 0.0)
    if mbps > 0:
        rate = NQ_SAFETY * mbps * 1e6 / 8  # bytes per second
        secs = int(min(opts.nq_seconds, remaining // rate))  # a near-zero rate gives inf
    else:
        secs = min(opts.nq_seconds, NQ_BLIND_SECONDS)
    if secs < NQ_MIN_SECONDS:
        return None, f"skipped: at ~{mbps:.0f} Mbps a {NQ_MIN_SECONDS} s run could pass the {opts.budget_mb:g} MB budget"
    return secs, None


# ---------------------------------------------------------------- probing


def _median(xs):
    xs = [x for x in xs if x is not None]
    return statistics.median(xs) if xs else None


def combine_rounds(parts) -> dict:
    """Pool several rounds of one link's probes into one result."""
    if len(parts) == 1:
        return dict(parts[0], rounds=1)
    out = {"rounds": len(parts)}
    pings = [p.get("ping") for p in parts if (p.get("ping") or {}).get("sent")]
    if pings:
        sent = sum(p["sent"] for p in pings)
        recv = sum(p["received"] for p in pings)
        ping = {"sent": sent, "received": recv, "loss_pct": 100.0 * max(sent - recv, 0) / sent}
        timed = [p for p in pings if p.get("received") and p.get("avg_ms") is not None]
        if timed:
            n = sum(p["received"] for p in timed)
            mean = sum(p["avg_ms"] * p["received"] for p in timed) / n
            var = sum(p["received"] * ((p.get("stddev_ms") or 0.0) ** 2 + (p["avg_ms"] - mean) ** 2) for p in timed) / n
            ping.update(
                min_ms=min(p["min_ms"] for p in timed),
                avg_ms=round(mean, 3),
                max_ms=max(p["max_ms"] for p in timed),
                stddev_ms=round(math.sqrt(var), 3),
            )
        out["ping"] = ping
    else:
        out["ping"] = next((p.get("ping") for p in parts if p.get("ping")), None)
    conns = [p["conns"] for p in parts if p.get("conns")]
    if conns:
        by_host = {h: [sum(c["by_host"][h][0] for c in conns), sum(c["by_host"][h][1] for c in conns)] for h in HOSTS}
        out["conns"] = {
            "attempted": sum(c["attempted"] for c in conns),
            "ok": sum(c["ok"] for c in conns),
            "by_host": by_host,
            "tls_s": [t for c in conns for t in c.get("tls_s", [])],
            "failures": [f for c in conns for f in c.get("failures", [])],
        }
    dnss = [p["dns"] for p in parts if p.get("dns")]
    if dnss:
        times = [t for d in dnss for t in d.get("times_ms", [])]
        out["dns"] = {
            "server": dnss[-1].get("server"),
            "attempts": sum(d.get("attempts", 0) for d in dnss),
            "ok": sum(d.get("ok", 0) for d in dnss),
            "times_ms": times,
            "median_ms": _median(times),
            "max_ms": max(times) if times else None,
            "failures": [f for d in dnss for f in d.get("failures", [])],
        }
    streams = [p["stream"] for p in parts if p.get("stream")]
    if streams:
        out["stream"] = {
            "down_mbps": _median([s.get("down_mbps") for s in streams]),
            "up_mbps": _median([s.get("up_mbps") for s in streams]),
            "bytes": sum(s.get("bytes") or 0 for s in streams),
        }
    nqs = [p["nq"] for p in parts if p.get("nq")]
    if nqs:
        done = [n for n in nqs if n.get("down_mbps") is not None or n.get("up_mbps") is not None]
        moved = sum(n.get("bytes") or 0 for n in nqs)
        if done:
            out["nq"] = {
                "down_mbps": _median([n.get("down_mbps") for n in done]),
                "up_mbps": _median([n.get("up_mbps") for n in done]),
                "rpm": _median([n.get("rpm") for n in done]),
                "base_rtt_ms": _median([n.get("base_rtt_ms") for n in done]),
                "bytes": moved,
                "runs": len(done),
            }
        else:
            out["nq"] = dict(nqs[-1], bytes=moved)
    return out


class Prober:
    """Measures links. Every external effect goes through runner, dns,
    resolve, clock and sleep, so tests can drive it without a network."""

    def __init__(self, runner=None, *, opts=None, dns=dns_lookup, resolve=system_resolve,
                 clock=time.time, sleep=time.sleep, log=None):
        self.runner = runner or Runner()
        self.opts = opts or Options()
        self.dns = dns
        self.resolve = resolve
        self.clock = clock
        self.sleep = sleep
        self.log = log or (lambda msg: None)

    # -- reads (no traffic)
    def default_routes(self):
        p = self.runner.run(["netstat", "-rn", "-f", "inet"], 10)
        return parse_default_routes(p.out) if p.rc == 0 else {}

    def primary_interface(self):
        p = self.runner.run(["route", "-n", "get", "default"], 10)
        m = re.search(r"^\s*interface:\s*(\S+)", p.out, re.M)
        return m[1] if p.rc == 0 and m else None

    def hardware_ports(self):
        p = self.runner.run(["networksetup", "-listallhardwareports"], 15)
        return parse_hardware_ports(p.out) if p.rc == 0 else {}

    def ipaddr(self, iface):
        p = self.runner.run(["ipconfig", "getifaddr", iface], 5)
        ip = p.out.strip()
        return ip if p.rc == 0 and _is_ipv4(ip) else None

    def gateway(self, iface):
        return (self.default_routes().get(iface) or {}).get("gateway")

    def summary(self, iface):
        p = self.runner.run(["ipconfig", "getsummary", iface], 10)
        return parse_summary(p.out) if p.rc == 0 else {}

    def dns_server(self, iface):
        p = self.runner.run(["ipconfig", "getoption", iface, "domain_name_server"], 5)
        ip = p.out.strip()
        return ip if p.rc == 0 and _is_ipv4(ip) else None

    def wlan(self, iface):
        p = self.runner.run(["osascript", "-l", "JavaScript", "-e", WLAN_JXA, iface], 10)
        return parse_wlan_json(p.out) if p.rc == 0 else None

    def if_bytes(self, iface):
        p = self.runner.run(["netstat", "-ibn", "-I", iface], 5)
        return parse_if_bytes(p.out, iface) if p.rc == 0 else None

    def wifi_interface(self):
        for dev, port in self.hardware_ports().items():
            if port == "Wi-Fi" and _is_iface(dev):
                return dev
        return None

    def candidates(self, only=None):
        """Every en* interface with an IPv4 address and a default route (or
        the ones named in only), primary first."""
        routes = self.default_routes()
        ports = self.hardware_ports()
        primary = self.primary_interface()
        names = list(only) if only else [i for i in routes if _is_iface(i)]
        out = []
        for iface in names:
            if not _is_iface(iface):
                continue
            ip = self.ipaddr(iface)
            if not ip:
                continue
            port = ports.get(iface)
            if port is None and self.summary(iface).get("interfacetype") == "WiFi":
                port = "Wi-Fi"
            out.append({
                "interface": iface,
                "ip": ip,
                "gateway": (routes.get(iface) or {}).get("gateway"),
                "kind": "wifi" if port == "Wi-Fi" else "wired",
                "port": port or iface,
                "primary": iface == primary,
            })
        out.sort(key=lambda c: (not c["primary"], c["interface"]))
        return out

    # -- probes (each bound to its interface)
    def captive(self, iface):
        p = self.runner.run(["curl", "--interface", iface, "-s", "-m", "8", CAPTIVE_URL], 12)
        return p.rc == 0 and "Success" in p.out

    def egress(self, iface):
        p = self.runner.run(["curl", "--interface", iface, "-s", "-m", "8", IPINFO_URL], 12)
        return parse_ipinfo(p.out) if p.rc == 0 else None

    def ping(self, iface):
        o = self.opts
        limit = math.ceil(o.pings * o.ping_interval) + 5
        argv = ["ping", "-b", iface, "-c", str(o.pings), "-i", f"{o.ping_interval:g}", "-t", str(limit), PING_TARGET]
        p = self.runner.run(argv, limit + 5)
        got = parse_ping(p.out)
        if got is None:
            return {"sent": 0, "received": 0, "loss_pct": None,
                    "error": ((p.err or p.out).strip()[-200:] or f"exit {p.rc}")}
        return got

    def dns_check(self, iface, server):
        if not server:
            return {"server": None, "attempts": 0, "ok": 0, "times_ms": [], "median_ms": None, "max_ms": None,
                    "failures": ["no DHCP DNS server"]}
        times, failures = [], []
        for _ in range(self.opts.dns_tries):
            for host in HOSTS:
                ok, ms, detail = self.dns(server, host, iface)
                if ok:
                    times.append(ms)
                else:
                    failures.append(f"{host}: {detail}")
        return {"server": server, "attempts": self.opts.dns_tries * len(HOSTS), "ok": len(times), "times_ms": times,
                "median_ms": _median(times), "max_ms": max(times) if times else None, "failures": failures}

    def conns(self, iface, ips, per_host=None):
        """New HTTPS connections (HEAD, DNS excluded via --resolve), the
        way a session opens them. Success = curl completed the request."""
        fmt = "%{exitcode} %{http_code} %{time_connect} %{time_appconnect}"
        by_host = {h: [0, 0] for h in HOSTS}
        tls, failures = [], []
        for _ in range(self.opts.conns if per_host is None else per_host):
            for host in HOSTS:
                argv = ["curl", "-I", "--interface", iface, "--resolve", f"{host}:443:{ips[host]}", "-s", "-o",
                        "/dev/null", "--connect-timeout", "5", "-m", "8", "-w", fmt, f"https://{host}/"]
                p = self.runner.run(argv, 12)
                w = parse_curl_w(p.out)
                by_host[host][1] += 1
                if p.rc == 0 and w and w["http_code"] != "000":
                    by_host[host][0] += 1
                    tls.append(round(w["tls_s"], 3))
                else:
                    failures.append({"host": host, "exit": "timeout" if p.stopped else p.rc})
        return {"attempted": sum(v[1] for v in by_host.values()), "ok": sum(v[0] for v in by_host.values()),
                "by_host": by_host, "tls_s": tls, "failures": failures}

    def stream(self, iface):
        """One bounded download and upload (5 MB / 2.5 MB by default): a
        one-connection rate, and the estimate the networkQuality plan uses."""
        o = self.opts
        fmt = "%{exitcode} %{size_download} %{speed_download} %{size_upload} %{speed_upload} %{time_total}"
        out = {"down_mbps": None, "up_mbps": None, "bytes": 0}
        down = ["curl", "--interface", iface, "-s", "-o", "/dev/null", "-m", f"{o.stream_seconds:g}", "-w", fmt,
                STREAM_DOWN_URL.format(n=int(o.stream_down_mb * 1e6))]
        p = self.runner.run(down, o.stream_seconds + 5)
        w = parse_stream_w(p.out)
        if w:
            out["bytes"] += w["size_download"]
            if p.rc in (0, 28) and w["size_download"] > 0 and w["speed_download"] > 0:
                out["down_mbps"] = round(w["speed_download"] * 8 / 1e6, 2)
        up = ["curl", "--interface", iface, "-s", "-o", "/dev/null", "-m", f"{o.stream_seconds:g}",
              "-H", "Content-Type: application/octet-stream", "--data-binary", "@-", "-w", fmt, STREAM_UP_URL]
        p = self.runner.run(up, o.stream_seconds + 5, stdin=bytes(int(o.stream_up_mb * 1e6)))
        w = parse_stream_w(p.out)
        if w:
            out["bytes"] += w["size_upload"]
            if p.rc in (0, 28) and w["size_upload"] > 0 and w["speed_upload"] > 0:
                out["up_mbps"] = round(w["speed_upload"] * 8 / 1e6, 2)
        return out

    def nq(self, iface, used_bytes, stream):
        secs, why = nq_plan(self.opts, used_bytes, stream)
        if secs is None:
            return {"skipped": why, "bytes": 0}
        remaining = self.opts.budget_mb * 1e6 - used_bytes
        start = self.if_bytes(iface)

        def should_stop(_elapsed):
            # Counts everything on the link, the fleet's own traffic included,
            # so it stops early rather than late.
            now = self.if_bytes(iface) if start else None
            if now and sum(now) - sum(start) >= remaining:
                return "budget"
            return None

        p = self.runner.run_watched(["networkQuality", "-I", iface, "-M", str(secs), "-c"], secs + 15, should_stop)
        end = self.if_bytes(iface) if start else None
        moved = sum(end) - sum(start) if start and end else None
        if p.stopped:
            return {"stopped": p.stopped, "planned_s": secs, "seconds": round(p.seconds, 1), "bytes": moved or 0}
        got = parse_nq_json(p.out)
        if not got or got.get("error"):
            err = (got or {}).get("error") or (p.err.strip()[-200:] or f"exit {p.rc}")
            return {"error": err, "planned_s": secs, "bytes": (got or {}).get("bytes") or moved or 0}
        got["planned_s"] = secs
        if got.get("bytes") is None:
            got["bytes"] = moved or 0
        return got

    def api_check(self, iface, n=4):
        ips = {h: self.resolve(h) or FALLBACK_IPS[h] for h in HOSTS}
        return self.conns(iface, ips, per_host=n)

    # -- one measurement run over several links at the same moment
    def _phase(self, name, recs, fn):
        if not recs:
            return
        self.log(f"{name}: " + ", ".join(r["interface"] for r in recs))
        with concurrent.futures.ThreadPoolExecutor(max_workers=len(recs)) as ex:
            futures = [(ex.submit(fn, r), r) for r in recs]
            for fut, r in futures:
                try:
                    fut.result()
                except UnsafeCommand:
                    raise
                except Exception as e:  # one link's failure must not end the run
                    r["notes"].append(f"{name} failed: {type(e).__name__}: {e}")

    def _identify(self, r):
        iface = r["interface"]
        if r["kind"] == "wifi":
            r["security"] = self.summary(iface).get("security")
            r["wifi"] = self.wlan(iface)
            if not r["security"] and (r["wifi"] or {}).get("security"):
                r["security"] = r["wifi"]["security"]
        r["dns_server"] = self.dns_server(iface)
        r["online"] = self.captive(iface)
        r["egress"] = self.egress(iface) if r["online"] else None

    def measure(self, cands, mode="now", rounds=1, names=None):
        """Measure every candidate, phase by phase, all links in each phase at
        once: on a moving train, solo tests minutes apart gave the opposite
        picture from simultaneous ones (11/04)."""
        t0 = self.clock()
        run = utc_stamp(t0).replace("-", "").replace(":", "") + "-" + os.urandom(2).hex()
        recs = []
        for c in cands:
            recs.append({"v": SCHEMA, "time": utc_stamp(t0), "run": run, "mode": mode, **c,
                         "security": None, "wifi": None, "online": False, "notes": []})
        self._phase("identify", recs, self._identify)
        live = [r for r in recs if r["online"]]
        for r in recs:
            if not r["online"]:
                r["notes"].append("no internet (captive portal not signed in?)")
        ips = {h: self.resolve(h) or FALLBACK_IPS[h] for h in HOSTS} if live else {}
        parts = {r["interface"]: [] for r in live}
        used = {r["interface"]: 0 for r in live}
        for k in range(max(1, rounds)):
            part = {r["interface"]: {} for r in live}
            if rounds > 1:
                self.log(f"round {k + 1} of {rounds}")

            def do_ping(r, part=part):
                part[r["interface"]]["ping"] = self.ping(r["interface"])

            def do_conns(r, part=part):
                part[r["interface"]]["dns"] = self.dns_check(r["interface"], r.get("dns_server"))
                part[r["interface"]]["conns"] = self.conns(r["interface"], ips)

            def do_stream(r, part=part):
                if self.opts.stream:
                    st = self.stream(r["interface"])
                    used[r["interface"]] += st["bytes"]
                    part[r["interface"]]["stream"] = st

            def do_nq(r, part=part):
                if self.opts.nq:
                    got = self.nq(r["interface"], used[r["interface"]], part[r["interface"]].get("stream"))
                    used[r["interface"]] += got.get("bytes") or 0
                    part[r["interface"]]["nq"] = got

            phases = [("ping", do_ping), ("dns + connections", do_conns)]
            if self.opts.stream:
                phases.append(("bounded transfer", do_stream))
            if self.opts.nq:
                phases.append(("networkQuality", do_nq))
            for name, fn in phases:
                self._phase(name, live, fn)
            for r in live:
                parts[r["interface"]].append(part[r["interface"]])
        for r in live:
            r.update(combine_rounds(parts[r["interface"]]))
        for r in recs:
            r["duration_s"] = round(self.clock() - t0, 1)
            finalize(r, names)
        return recs


# ---------------------------------------------------------------- history


def state_dir() -> Path:
    return Path(os.environ.get("NETPICK_HOME") or Path.home() / ".local" / "state" / "netpick")


class Store:
    """Append-only JSONL history plus a names file next to it."""

    def __init__(self, path=None):
        self.path = Path(path or os.environ.get("NETPICK_HISTORY") or state_dir() / "history.jsonl").expanduser()
        self.names_path = self.path.with_name("names.json")

    def append(self, records):
        if not records:
            return
        self.path.parent.mkdir(parents=True, exist_ok=True)
        with open(self.path, "a", encoding="utf-8") as f:
            fcntl.flock(f, fcntl.LOCK_EX)
            for r in records:
                f.write(json.dumps(r, sort_keys=True, separators=(",", ":"), ensure_ascii=False) + "\n")
            f.flush()

    def load(self):
        """-> (records, number of unreadable lines skipped)."""
        if not self.path.exists():
            return [], 0
        recs, bad = [], 0
        with open(self.path, encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    r = json.loads(line)
                except ValueError:
                    bad += 1
                    continue
                if isinstance(r, dict) and r.get("time") and r.get("network_id"):
                    recs.append(r)
                else:
                    bad += 1
        return recs, bad

    def names(self):
        try:
            data = json.loads(self.names_path.read_text())
        except (OSError, ValueError):
            return {}
        return {k: v for k, v in data.items() if isinstance(k, str) and isinstance(v, str)} if isinstance(data, dict) else {}

    def set_name(self, nid, name):
        names = self.names()
        if name:
            names[nid] = name
        else:
            names.pop(nid, None)
        self.names_path.parent.mkdir(parents=True, exist_ok=True)
        tmp = self.names_path.with_suffix(".tmp")
        tmp.write_text(json.dumps(names, indent=2, sort_keys=True, ensure_ascii=False) + "\n")
        tmp.replace(self.names_path)


def parse_window(s):
    """'90s', '30m', '2h', '7d', '2w' -> seconds; 'all' or '0' -> None (no window)."""
    s = (s or "").strip().lower()
    if s in ("", "all", "0"):
        return None
    m = re.fullmatch(r"(\d+(?:\.\d+)?)\s*([smhdw])", s)
    if not m:
        raise ValueError(f"bad window {s!r}: use e.g. 30m, 2h, 7d or all")
    return float(m[1]) * {"s": 1, "m": 60, "h": 3600, "d": 86400, "w": 604800}[m[2]]


def latest_per_network(recs):
    best = {}
    for r in recs:
        t = parse_stamp(r.get("time"))
        if t is None:
            continue
        if r["network_id"] not in best or t >= parse_stamp(best[r["network_id"]]["time"]):
            best[r["network_id"]] = r
    return sorted(best.values(), key=lambda r: r["time"], reverse=True)


# ---------------------------------------------------------------- output


def fmt_mb(b) -> str:
    return "—" if not b else f"{b / 1e6:.0f}" if b >= 10e6 else f"{b / 1e6:.1f}"


def fmt_age(seconds) -> str:
    if seconds is None:
        return "?"
    if seconds < 90:
        return f"{seconds:.0f}s ago"
    if seconds < 5400:
        return f"{seconds / 60:.0f}m ago"
    if seconds < 172800:
        return f"{seconds / 3600:.0f}h ago"
    return f"{seconds / 86400:.0f}d ago"


def render(rows, headers, right=()) -> str:
    table = [list(map(str, headers))] + [list(map(str, r)) for r in rows]
    widths = [max(len(row[i]) for row in table) for i in range(len(headers))]
    lines = []
    for row in table:
        cells = [c.rjust(widths[i]) if i in right else c.ljust(widths[i]) for i, c in enumerate(row)]
        lines.append("  ".join(cells).rstrip())
    return "\n".join(lines)


def table(ranked, names=None, current=None, now=None, when=False) -> str:
    headers = ["#", "network", "id", "conns", "loss", "rtt ms", "up/down Mbps", "via", "rpm", "MB"]
    if when:
        headers.append("measured")
    rows = []
    for i, r in enumerate(ranked, 1):
        m = r.get("metrics") or compute_metrics(r)
        c, p = r.get("conns") or {}, r.get("ping") or {}
        name = display_name(r, names) + (" *" if current is not None and r is current else "")
        if not r.get("online"):
            row = [i, name, r.get("network_id", ""), "offline", "—", "—", "—", "—", "—", fmt_mb(r.get("data_bytes"))]
        else:
            if p.get("received") and p.get("avg_ms") is not None:
                rtt = f"{p['avg_ms']:.0f}±{(p.get('stddev_ms') or 0):.0f}"
            else:
                rtt = "blocked" if p.get("sent") and c.get("ok") else "—"
            row = [
                i,
                name,
                r.get("network_id", ""),
                f"{c.get('ok', 0)}/{c.get('attempted', 0)}" if c.get("attempted") else "—",
                "—" if m.get("loss_pct") is None else f"{m['loss_pct']:.1f}%",
                rtt,
                f"{fmt_rate(m.get('up_mbps'))}/{fmt_rate(m.get('down_mbps'))}",
                {"nq": "nq", "stream": "1-conn", "mixed": "mixed"}.get(m.get("via"), "—"),
                "—" if m.get("rpm") is None else f"{m['rpm']:.0f}",
                fmt_mb(r.get("data_bytes")),
            ]
        if when:
            t = parse_stamp(r.get("time"))
            row.append(fmt_age(now - t) if now is not None and t is not None else r.get("time", "?"))
        rows.append(row)
    return render(rows, headers, right={0, 3, 4, 5, 6, 8, 9})


def notes_for(recs) -> list:
    lines = []
    for r in recs:
        nq = r.get("nq") or {}
        tag = r.get("interface", "?")
        if nq.get("skipped") and nq["skipped"] != "off":
            lines.append(f"{tag}: networkQuality {nq['skipped']}")
        elif nq.get("stopped"):
            lines.append(f"{tag}: networkQuality stopped ({nq['stopped']}) after {nq.get('seconds')} s")
        elif nq.get("error"):
            lines.append(f"{tag}: networkQuality failed: {nq['error']}")
        d = r.get("dns") or {}
        if d.get("attempts"):
            med = d.get("median_ms")
            lines.append(f"{tag}: DNS {d['server']} answered {d['ok']}/{d['attempts']}"
                         + (f", median {med:.0f} ms, max {d['max_ms']:.0f} ms" if med is not None else ""))
        for n in r.get("notes") or []:
            lines.append(f"{tag}: {n}")
    return lines


# ---------------------------------------------------------------- commands


def options_from(args) -> Options:
    o = Options(pings=args.pings, conns=args.conns, budget_mb=args.budget_mb, nq_seconds=args.nq_seconds)
    if args.no_nq:
        o.nq = False
    if args.no_transfer:
        o.stream = False
    if args.quick:
        o.nq = o.stream = False
    return o


def cmd_now(args, prober, store, out):
    window = parse_window(args.recent)
    only = [s.strip() for s in args.interfaces.split(",") if s.strip()] if args.interfaces else None
    cands = prober.candidates(only)
    if not cands:
        out("No candidate links: no en* interface has an IPv4 address and a default route.")
        return 3
    names = store.names()
    recs = prober.measure(cands, mode="now", rounds=args.rounds, names=names)
    if not args.no_history:
        store.append(recs)
    ranked = rank(recs)
    current = next((r for r in recs if r.get("primary")), None)
    rec = recommend(ranked, current, names)
    earlier = []
    if window:
        live_ids = {r["network_id"] for r in recs}
        now = prober.clock()
        history, _bad = store.load()
        earlier = [r for r in latest_per_network(history)
                   if r["network_id"] not in live_ids and r.get("mode") != "import"
                   and (parse_stamp(r["time"]) or 0) >= now - window]
    if args.json:
        out(json.dumps({
            "version": VERSION,
            "records": recs,
            "ranking": [r["network_id"] for r in ranked],
            "recommendation": {"action": rec["action"], "text": rec["text"],
                               "interface": (rec["pick"] or {}).get("interface"),
                               "network_id": (rec["pick"] or {}).get("network_id")},
            "earlier": earlier,
        }, indent=2, ensure_ascii=False))
        return 0
    out(table(ranked, names, current))
    out("")
    out(rec["text"])
    for line in notes_for(recs):
        out("  " + line)
    if earlier:
        out("")
        out(f"Measured earlier (within {args.recent}), not now:")
        out(table(rank(earlier), names, now=prober.clock(), when=True))
        top_earlier = rank(earlier)[0]
        pick = rec.get("pick")
        if pick and top_earlier.get("online"):
            d = deciding(top_earlier["metrics"], pick["metrics"])
            if d and d[1] and rank_key(top_earlier["metrics"]) < rank_key(pick["metrics"]):
                out(f"{display_name(top_earlier, names)} beat {display_name(pick, names)} on {FIELD_WORDS[d[0]]} "
                    "when measured; to recheck it, run `netpick watch --baseline` and pick it in the Wi-Fi menu.")
    total = sum(r.get("data_bytes") or 0 for r in recs)
    used = f"{fmt_mb(total)} MB" if total >= 1e6 else "under 1 MB"
    out(f"\n{len(recs)} link(s), {used} used, {max(r.get('duration_s') or 0 for r in recs):.0f} s"
        + ("" if args.no_history else f"; history: {store.path}"))
    return 0


def wait_online(prober, iface, gw, limit, out, step=3.0):
    """'online', 'timeout', or 'changed' when the gateway moves while waiting."""
    start = prober.clock()
    while True:
        if prober.captive(iface):
            out(f"   online after {prober.clock() - start:.0f}s")
            return "online"
        if prober.clock() - start >= limit:
            return "timeout"
        prober.sleep(step)
        if prober.gateway(iface) != gw:
            return "changed"


def settle_wait(prober, iface, gw, seconds, step=2.0):
    """Let DNS settle after a switch (11/05: 2 of 4 API calls failed with curl
    exit 6 in the first seconds; a minute later 35 of 35 worked)."""
    end = prober.clock() + seconds
    while prober.clock() < end:
        prober.sleep(min(step, max(end - prober.clock(), 0)))
        if prober.gateway(iface) != gw:
            return False
    return True


def watch_loop(prober, store, *, seen=(), baseline=False, max_new=3, minutes=30.0, portal_wait=480.0,
               settle=30.0, poll=2.0, out=print, record=True):
    wifi = prober.wifi_interface()
    if not wifi:
        out("No Wi-Fi interface found.")
        return 3
    names = store.names()
    start = prober.clock()
    seen = {g for g in seen if g}
    measured = []

    def stamp():
        return dt.datetime.fromtimestamp(prober.clock(), dt.timezone.utc).strftime("%H:%M:%SZ")

    def measure_now():
        cands = prober.candidates([wifi])
        if not cands:
            return None
        rec = prober.measure(cands, mode="watch", names=names)[0]
        if record:
            store.append([rec])
        measured.append(rec)
        return rec

    def show():
        cur_gw = prober.gateway(wifi)
        current = next((r for r in reversed(measured) if r.get("gateway") == cur_gw), None)
        ranked = rank(measured)
        out(table(ranked, names, current, now=prober.clock(), when=True))
        if len(measured) > 1:
            out("Measured one at a time, minutes apart; on a moving train conditions change between rows.")
        out(recommend(ranked, current, names)["text"])

    gw = prober.gateway(wifi)
    if baseline:
        if gw and prober.captive(wifi):
            out(f"{stamp()} baseline: measuring the current network (gateway {gw})")
            if measure_now():
                show()
        else:
            out(f"{stamp()} baseline skipped: the current Wi-Fi network has no internet")
    if gw:
        seen.add(gw)
    last = gw
    new = 0
    out(f"{stamp()} watching {wifi} for up to {minutes:g} min and {max_new} new network(s). Pick networks in the "
        "Wi-Fi menu and sign in to any portal; netpick never joins or leaves one.")
    while new < max_new and prober.clock() - start < minutes * 60:
        gw = prober.gateway(wifi)
        if gw and gw != last and prober.ipaddr(wifi):
            last = gw
            if gw in seen:
                out(f"{stamp()} back on gateway {gw} (tested already)")
                if wait_online(prober, wifi, gw, 60, out) == "online" and settle_wait(prober, wifi, gw, min(settle, 15)):
                    c = prober.api_check(wifi, 4)
                    out(f"   API check: {c['by_host'][HOSTS[0]][0]}/{c['by_host'][HOSTS[0]][1]} Claude API, "
                        f"{c['by_host'][HOSTS[1]][0]}/{c['by_host'][HOSTS[1]][1]} GitHub connections")
                continue
            seen.add(gw)
            sec = prober.summary(wifi).get("security") or "?"
            out(f"{stamp()} new network: gateway {gw}, ip {prober.ipaddr(wifi)}, security {sec}")
            left = minutes * 60 - (prober.clock() - start)
            status = wait_online(prober, wifi, gw, max(min(portal_wait, left), 0), out)
            if status == "changed":
                out("   the network changed while waiting for internet")
                continue
            if status != "online":
                out(f"   still no internet after {min(portal_wait, left) / 60:.0f} min (portal not signed in?); skipped")
                continue
            out(f"   letting DNS settle for {settle:g}s")
            if not settle_wait(prober, wifi, gw, settle):
                out("   the network changed while settling; skipped")
                continue
            out(f"{stamp()} measuring")
            if measure_now():
                new += 1
                show()
        prober.sleep(poll)
    out(f"{stamp()} done: measured {len(measured)} network(s)")
    if len(measured) > 1:
        show()
    return 0


def cmd_watch(args, prober, store, out):
    seen = [g.strip() for g in (args.seen or "").split(",") if g.strip()]
    try:
        return watch_loop(prober, store, seen=seen, baseline=args.baseline, max_new=args.max,
                          minutes=args.minutes, portal_wait=args.portal_wait, settle=args.settle,
                          poll=args.poll, out=out, record=not args.no_history)
    except KeyboardInterrupt:
        out("stopped")
        return 130


def cmd_history(args, store, out, now=None):
    now = time.time() if now is None else now
    recs, bad = store.load()
    names = store.names()
    window = parse_window(args.since)
    if window:
        recs = [r for r in recs if (parse_stamp(r["time"]) or 0) >= now - window]
    if args.network:
        q = args.network.lower()
        recs = [r for r in recs if r["network_id"].startswith(q) or q in display_name(r, names).lower()]
    if args.json:
        out(json.dumps(recs, indent=2, ensure_ascii=False))
        return 0
    if not recs:
        out(f"No measurements in {store.path}" + (f" within {args.since}" if window else "") + ".")
        return 0
    if args.rank:
        latest = rank(latest_per_network(recs))
        out(table(latest, names, now=now, when=True))
        out("Each network's latest measurement, taken at different times; recheck before acting on old rows.")
    elif args.by_network:
        groups = {}
        for r in recs:
            groups.setdefault(r["network_id"], []).append(r)
        rows = []
        for nid, rs in sorted(groups.items(), key=lambda kv: max(r["time"] for r in kv[1]), reverse=True):
            ms = [r.get("metrics") or compute_metrics(r) for r in rs]

            def med(key):
                return _median([m.get(key) for m in ms])

            conn = med("conn_ratio")
            loss, lat, up, down = med("loss_pct"), med("latency_ms"), med("up_mbps"), med("down_mbps")
            last = max(rs, key=lambda r: r["time"])
            rows.append([
                display_name(last, names), nid, len(rs),
                "—" if conn is None else f"{conn * 100:.0f}%",
                "—" if loss is None else f"{loss:.1f}%",
                "—" if lat is None else f"{lat:.0f}",
                f"{fmt_rate(up)}/{fmt_rate(down)}",
                fmt_age(now - (parse_stamp(last["time"]) or now)),
            ])
        out(render(rows, ["network", "id", "n", "conns", "loss", "rtt ms", "up/down Mbps", "last"], right={2, 3, 4, 5, 6}))
        out("Medians over each network's measurements.")
    else:
        shown = sorted(recs, key=lambda r: r["time"])[-args.limit:]
        out(table(shown, names, now=now, when=True))
    if bad:
        out(f"({bad} unreadable line(s) skipped)")
    return 0


def cmd_import(args, store, out):
    existing, _ = store.load()
    keys = {(r.get("time"), r.get("interface"), r.get("source_label")) for r in existing}
    added = []
    for path in args.files:
        try:
            text = Path(path).read_text(errors="replace")
        except OSError as e:
            out(f"{path}: {e.strerror}")
            continue
        rec = parse_capture(text, source=Path(path).name)
        if rec is None:
            out(f"{path}: not a nettest.sh capture")
            continue
        key = (rec["time"], rec["interface"], rec["source_label"])
        if key in keys:
            out(f"{path}: already in the history")
            continue
        keys.add(key)
        added.append(rec)
        out(f"{path}: {rec['source_label']} at {rec['time']} -> {rec['network_id']} ({rec['label']})")
    store.append(added)
    out(f"imported {len(added)} measurement(s) into {store.path}")
    return 0


def cmd_name(args, store, out):
    names = store.names()
    if args.list or not args.id:
        if not names:
            out("No names yet. Use: netpick name ID NAME (ids appear in netpick's tables).")
        for nid, name in sorted(names.items(), key=lambda kv: kv[1].lower()):
            out(f"{nid}  {name}")
        return 0
    recs, _ = store.load()
    ids = {r["network_id"] for r in recs} | set(names)
    matches = sorted(i for i in ids if i.startswith(args.id.lower()))
    if len(matches) != 1:
        out(f"{args.id}: " + ("no such network id" if not matches else "ambiguous: " + ", ".join(matches)))
        return 2
    nid = matches[0]
    store.set_name(nid, None if args.clear else " ".join(args.name).strip() or None)
    out(f"{nid}: " + ("name cleared" if args.clear or not args.name else f"named {' '.join(args.name).strip()!r}"))
    return 0


def cmd_interfaces(args, prober, out):
    cands = prober.candidates()
    for c in cands:
        if c["kind"] == "wifi":
            c["security"] = prober.summary(c["interface"]).get("security")
    if args.json:
        out(json.dumps(cands, indent=2))
        return 0 if cands else 3
    if not cands:
        out("No candidate links: no en* interface has an IPv4 address and a default route.")
        return 3
    rows = [[c["interface"], c["port"], c["ip"], c["gateway"] or "—", c.get("security") or "",
             "primary" if c["primary"] else ""] for c in cands]
    out(render(rows, ["iface", "port", "ip", "gateway", "security", "route"]))
    return 0


def build_parser():
    p = argparse.ArgumentParser(
        prog="netpick",
        description="Which network should this Mac use right now? Measures each link with every probe bound to its "
        "interface, ranks the links for many Claude Code sessions, and never switches networks.",
    )
    p.add_argument("--version", action="version", version=f"netpick {VERSION}")
    sub = p.add_subparsers(dest="cmd", metavar="COMMAND")

    def history_flag(sp):
        sp.add_argument("--history", metavar="PATH",
                        help="history file (default ~/.local/state/netpick/history.jsonl or $NETPICK_HISTORY)")

    def probe_flags(sp):
        g = sp.add_argument_group("probes")
        g.add_argument("--pings", type=int, default=40, help="pings per link, 0.25 s apart (default 40)")
        g.add_argument("--conns", type=int, default=4, help="HTTPS connections per host per link (default 4, so 8)")
        g.add_argument("--budget-mb", type=float, default=100.0,
                       help="data cap per link per run, networkQuality included (default 100)")
        g.add_argument("--nq-seconds", type=int, default=20, help="longest networkQuality run (default 20)")
        g.add_argument("--no-nq", action="store_true", help="skip networkQuality (no responsiveness)")
        g.add_argument("--no-transfer", action="store_true", help="skip the bounded 5 MB down / 2.5 MB up transfer")
        g.add_argument("--quick", action="store_true", help="ping, DNS and connections only: well under 1 MB per link")
        sp.add_argument("--no-history", action="store_true", help="don't append to the history")
        history_flag(sp)

    now = sub.add_parser("now", help="measure the live links now and recommend one (the default)")
    probe_flags(now)
    now.add_argument("--interfaces", metavar="LIST", help="comma-separated, e.g. en0,en13 (default: every en* link)")
    now.add_argument("--rounds", type=int, default=1, help="repeat the paired measurement and pool the rounds")
    now.add_argument("--recent", default="2h", help="also list other networks measured this recently (default 2h; 0 hides)")
    now.add_argument("--json", action="store_true", help="print records, ranking and recommendation as JSON")

    w = sub.add_parser("watch", help="measure each new Wi-Fi network Max switches to")
    probe_flags(w)
    w.add_argument("--seen", metavar="GATEWAYS", help="comma-separated gateways already tested (skipped)")
    w.add_argument("--baseline", action="store_true", help="measure the current Wi-Fi network first")
    w.add_argument("--max", type=int, default=3, help="stop after this many new networks (default 3)")
    w.add_argument("--minutes", type=float, default=30.0, help="stop after this long (default 30)")
    w.add_argument("--portal-wait", type=float, default=480.0, help="seconds to wait for a portal sign-in (default 480)")
    w.add_argument("--settle", type=float, default=30.0, help="seconds to let DNS settle before measuring (default 30)")
    w.add_argument("--poll", type=float, default=2.0, help="seconds between gateway checks (default 2)")

    h = sub.add_parser("history", help="past measurements")
    history_flag(h)
    h.add_argument("--since", default="all", help="window such as 2h, 7d or all (default all)")
    h.add_argument("--network", metavar="ID|TEXT", help="only this network id (prefix) or name/label text")
    h.add_argument("--limit", type=int, default=30, help="rows to show (default 30)")
    mode = h.add_mutually_exclusive_group()
    mode.add_argument("--rank", action="store_true", help="rank each network's latest measurement")
    mode.add_argument("--by-network", action="store_true", help="one row per network with medians")
    h.add_argument("--json", action="store_true")

    imp = sub.add_parser("import", help="load nettest.sh captures (nettest_*.txt) into the history")
    history_flag(imp)
    imp.add_argument("files", nargs="+")

    n = sub.add_parser("name", help="name a network (ids appear in the tables)")
    history_flag(n)
    n.add_argument("id", nargs="?")
    n.add_argument("name", nargs="*")
    n.add_argument("--clear", action="store_true", help="remove the name")
    n.add_argument("--list", action="store_true", help="list names")

    i = sub.add_parser("interfaces", help="list candidate links without measuring")
    i.add_argument("--json", action="store_true")
    return p


def main(argv=None, *, prober=None, store=None, out=None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv or (argv[0].startswith("-") and argv[0] not in ("-h", "--help", "--version")):
        argv = ["now", *argv]
    args = build_parser().parse_args(argv)
    out = out or (lambda s="": print(s, flush=True))
    store = store or Store(getattr(args, "history", None))
    for flag in ("recent", "since"):
        try:
            parse_window(getattr(args, flag, None))
        except ValueError as e:
            out(f"netpick: --{flag}: {e}")
            return 2
    if args.cmd == "history":
        return cmd_history(args, store, out)
    if args.cmd == "import":
        return cmd_import(args, store, out)
    if args.cmd == "name":
        return cmd_name(args, store, out)
    if prober is None:
        if sys.platform != "darwin":
            out("netpick measures links with macOS tools (ping -b, networkQuality); run it on the Mac.")
            return 2
        t0 = time.monotonic()
        prober = Prober(log=lambda msg: print(f"netpick {time.monotonic() - t0:5.1f}s  {msg}", file=sys.stderr, flush=True))
    if args.cmd == "interfaces":
        return cmd_interfaces(args, prober, out)
    prober.opts = options_from(args)
    if args.cmd == "watch":
        return cmd_watch(args, prober, store, out)
    return cmd_now(args, prober, store, out)


if __name__ == "__main__":
    sys.exit(main())
